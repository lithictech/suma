{
  "name": "suma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/browser": "^7.102.0",
    "@sentry/tracing": "^7.102.0",
    "axios": "^1.2.3",
    "axios-retry": "^4.5.0",
    "clsx": "^1.2.1",
    "credit-card-type": "^10.1.0",
    "dayjs": "^1.11.7",
    "history": "^5.3.0",
    "humps": "git+https://github.com/lithictech/humps.git#fb9844c8d37cea67ee9c592e2685aee68d05015f",
    "leaflet": "^1.9.3",
    "leaflet.animatedmarker": "^1.0.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.17.21",
    "luhn": "^2.4.1",
    "markdown-to-jsx": "^7.7.4",
    "preact": "^10.23.2",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.42.1",
    "react-router-dom": "^7.18.2",
    "sass": "^1.57.1",
    "vite": "^6.1.2"
  },
  "scripts": {
    "analyze": "vite-bundle-visualizer ../build-webapp/assets/*.js --output=source-explorer.html",
    "start": "vite --port 22004",
    "start-network": "vite --port 22004 --host",
    "build": "vite build --base=/app",
    "test": "vitest --passWithNoTests --globals",
    "serve": "vite preview",
    "prettier-check": "prettier --no-error-on-unmatched-pattern --check '*.{jsx,js,tsx,ts}' './tools/*.{jsx,js,tsx,ts}' './src/**/*.{jsx,js,tsx,ts}'",
    "prettier-fix": "prettier --no-error-on-unmatched-pattern --write '*.{jsx,js,tsx,ts}' './tools/*.{jsx,js,tsx,ts}' './src/**/*.{jsx,js,tsx,ts}'",
    "eslint-check": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings=0 --no-error-on-unmatched-pattern . './tools/' './src/'",
    "eslint-fix": "eslint --ext .js,.jsx,.ts,.tsx --no-error-on-unmatched-pattern --fix . './tools/' './src/'",
    "type-check": "tsc --noEmit",
    "storybook-start": "storybook dev -p 22016",
    "storybook-build": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@preact/preset-vite": "^2.10.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/preact-vite": "^10.5.9",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/browser": "3.0.9",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-storybook": "^10.5.9",
    "playwright": "latest",
    "prettier": "^2.8.3",
    "qrcode": "^1.5.1",
    "storybook": "^10.5.9",
    "typescript": "^5.6.0",
    "vite-bundle-visualizer": "^0.10.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^4.1.0",
    "vitest": "^3.0.9"
  }
}
